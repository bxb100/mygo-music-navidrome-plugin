{
  "name": "mygo-music-navidrome",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "pack": "vp pack",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test:plugin": "node --import tsx --test tests/*.test.ts",
    "test:tooling": "node --import tsx --test tests/tooling/*.test.ts",
    "test": "pnpm build && pnpm test:plugin && pnpm test:tooling",
    "package": "tsx scripts/package.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm package",
    "version:set": "tsx scripts/version.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fflate": "0.8.3",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "1.4.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0"
}
